# The three closed-source halves of the PCVR feature. These URLs are private
# repositories: a clone by anyone else fails here with an authentication error,
# which is the correct and expected outcome — the public app never needs them
# (see CompanionWindows/app/src/pcvr-installer.js for how it gets the built
# bundle instead).
#
# They are deliberately NOT the local paths they are developed from. A local
# path in a committed .gitmodules leaks one machine's directory layout and makes
# `git clone --recursive` fail with a confusing "no such file" for everybody
# else. Point the working copy at the local repos instead, which overrides these
# without touching the file:
#
#   git config submodule.Longwave-PCVR-Host.url ~/Projects/longwave-pcvr-host
#   git config submodule.SessionBroker.url       ~/Projects/longwave-session-broker
#   git config submodule.OpenXRLayer.url         ~/Projects/longwave-openxr-layer
#   git -C Longwave-PCVR-Host remote set-url origin ~/Projects/longwave-pcvr-host
#   git -C SessionBroker      remote set-url origin ~/Projects/longwave-session-broker
#   git -C OpenXRLayer        remote set-url origin ~/Projects/longwave-openxr-layer
#
# Set the module remotes directly, as above, and do NOT run `git submodule sync`
# afterwards: sync copies the URLs *out of this file* into the config, which
# undoes the override you just made rather than applying it.
[submodule "Longwave-PCVR-Host"]
	path = Longwave-PCVR-Host
	url = https://github.com/illixion/longwave-pcvr-host.git
[submodule "SessionBroker"]
	path = SessionBroker
	url = https://github.com/illixion/longwave-session-broker.git
[submodule "OpenXRLayer"]
	path = OpenXRLayer
	url = https://github.com/illixion/longwave-openxr-layer.git
