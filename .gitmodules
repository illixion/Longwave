# The three closed-source halves of the PCVR feature. These URLs are private
# repositories: a clone by anyone else fails here with an authentication error,
# which is the correct and expected outcome — the public app never needs them
# (see CompanionWindows/app/src/pcvr-installer.js for how it gets the built
# bundle instead).
#
# GitHub is the only source for all three. This used to describe a second one —
# a clone of each under ~/Projects, wired in as `origin` through a
# `git config submodule.<name>.url <path>` override — and that arrangement is
# retired because it silently rotted: the submodule histories were rewritten
# onto signed commits, the local clones were not, and the two drifted about
# eighty commits apart while still looking like a valid remote. A stale remote
# that answers is worse than no remote at all. Their pre-rewrite history is kept
# as bundles (~/Projects/_archive/*-prerewrite-*.bundle) and nothing unique was
# in them: the pre-split work also lives in this repo's own history.
#
# The URLs below stay HTTPS so `git clone --recursive` fails with a clean
# authentication error for anyone without access, which is the intended outcome
# — the public app never needs these (see
# CompanionWindows/app/src/pcvr-installer.js for how it gets the built bundle).
# A working copy that does have access uses SSH instead, per-machine and without
# touching this file:
#
#   git config submodule.Longwave-PCVR-Host.url git@github.com:illixion/longwave-pcvr-host.git
#   git config submodule.SessionBroker.url      git@github.com:illixion/longwave-session-broker.git
#   git config submodule.OpenXRLayer.url        git@github.com:illixion/longwave-openxr-layer.git
#
# Do NOT run `git submodule sync` after setting those: sync copies the URLs *out
# of this file* into the config, undoing the override rather than applying it.
[submodule "Longwave-PCVR-Host"]
	path = Longwave-PCVR-Host
	url = https://github.com/illixion/longwave-pcvr-host.git
[submodule "SessionBroker"]
	path = SessionBroker
	url = https://github.com/illixion/longwave-session-broker.git
[submodule "OpenXRLayer"]
	path = OpenXRLayer
	url = https://github.com/illixion/longwave-openxr-layer.git
