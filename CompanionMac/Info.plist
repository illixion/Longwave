<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Longwave Companion</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>pro.longwave.companion</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>longwave-companion</string>
			</array>
		</dict>
	</array>
	<key>LSUIElement</key>
	<true/>
	<key>NSAppleEventsUsageDescription</key>
	<string>Longwave Companion controls Music and reads the current track so you can see and control playback from your Apple Vision Pro.</string>
	<key>NSAudioCaptureUsageDescription</key>
	<string>Longwave Companion captures system audio to stream it to the Longwave app on your Apple Vision Pro.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>This app serves audio and native Mac screen streams to Longwave clients on your local network.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_longwave-native._tcp</string>
	</array>
</dict>
</plist>
