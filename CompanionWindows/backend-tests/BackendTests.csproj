<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unit tests for the backend's portable parts (the game library today). Compiles the sources
       directly rather than referencing Backend.csproj, whose Windows-only target framework and
       WinRT dependencies would keep these from running on the Mac or a Linux CI runner.
       Run: dotnet test CompanionWindows/backend-tests -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RollForward>Major</RollForward>
    <!-- ArtScaler is Windows-only and guarded at runtime; the tests never reach it. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../backend/Games/*.cs" Link="Games/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="ValveKeyValue" Version="0.20.0.417" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>
</Project>
