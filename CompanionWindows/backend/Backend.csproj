<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Windows 11 SDK projection: the WinRT tethering APIs
         (Windows.Networking.NetworkOperators / Connectivity) plus
         Windows.Graphics.Capture (IsBorderRequired needs 22000+). -->
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Longwave.WindowsCompanion.Backend</RootNamespace>
    <AssemblyName>LongwaveWindowsCompanionBackend</AssemblyName>
    <!-- The backend touches the privileged tethering API; require admin when launched
         as an interactive-session helper. (Ignored when hosted as a SYSTEM service.) -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Allow compiling this Windows-targeted project on non-Windows dev
         machines (CI syntax checks, macOS development). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.EventLog" Version="8.0.1" />
    <!-- Native screen streaming: TLS-PSK (SChannel exposes no PSK suites) and
         the D3D11 / Media Foundation capture-encode pipeline. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.4.0" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.6.2" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.6.2" />
  </ItemGroup>

</Project>
