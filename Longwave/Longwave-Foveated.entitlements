<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  App Store edition only. scripts/edition-settings.sh appstore points the app
  target at this file through LONGWAVE_APP_ENTITLEMENTS; every other edition
  signs with Longwave.entitlements, so a team whose App ID lacks the
  foveated-streaming capability can still build the open-source app.

  Keep the app group in step with Longwave.entitlements.
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.foveated-streaming-session</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.pro.longwave</string>
	</array>
</dict>
</plist>
