<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The default for every build, so it carries only what an ordinary VNC-only
  build needs. The foveated-streaming capability lives in
  Longwave-Foveated.entitlements, which only the App Store edition selects
  (LONGWAVE_APP_ENTITLEMENTS in scripts/edition-settings.sh): a team whose
  provisioning profile does not grant it cannot sign an app that declares it.

  build-and-sign.sh re-signs with the entitlements extracted from the
  provisioning profile, so dev sideloads pick the capability up from the
  profile regardless of this file.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.pro.longwave</string>
	</array>
</dict>
</plist>
