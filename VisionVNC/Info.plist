<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CommitHash</key>
	<string>$(COMMIT_HASH)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.illixion.VisionVNC.audioToken</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>visionvnc</string>
			</array>
		</dict>
	</array>
	<key>GCSupportedGameControllers</key>
	<array>
		<dict>
			<key>ProfileName</key>
			<string>ExtendedGamepad</string>
		</dict>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>VisionVNC broadcasts your selected camera (such as Persona or Mirror My View) to your streaming server.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>VisionVNC uses your microphone to dictate messages into terminal sessions, and can include it in the broadcast stream.</string>
	<!-- Dictation transcribes on device via SpeechAnalyzer, which documents no
	     authorization step of its own. The key is declared anyway: it is the same
	     framework SFSpeechRecognizer gates on, and an API that asks for consent
	     with no usage string in the bundle terminates the app rather than being
	     denied. -->
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>VisionVNC transcribes your speech on this device to type messages into terminal sessions.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>VisionVNC connects to remote desktops, native Mac streams, game streaming hosts, and the Companion on your local network.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_visionvnc-native._tcp</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationPreferredDefaultSceneSessionRole</key>
		<string>UIWindowSceneSessionRoleApplication</string>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
