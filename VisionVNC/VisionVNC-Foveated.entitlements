<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  TEMPLATE — not used by any build target.

  Enabling FOVEATED_ENABLED requires the foveated-streaming entitlement at run
  time. It is intentionally kept OUT of the shared VisionVNC.entitlements so that
  ordinary (VNC-only) device builds keep working for a team without the
  capability. To turn the feature on, either:
    • Xcode → Signing & Capabilities → add the capability (edits the real
      .entitlements), or
    • merge the key below into the entitlements used for signing / the
      provisioning profile (build-and-sign.sh takes entitlements from the
      profile, so a profile that includes this capability needs no file edit).

  Also keep the app-group entitlement already present in VisionVNC.entitlements.
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.foveated-streaming-session</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.illixion.VisionVNC</string>
	</array>
</dict>
</plist>
