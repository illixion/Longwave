             self.method = .publicKey(.known(key: privateKeyRequest.publicKey, signature: signature))
+        case .customPublicKey:
+            preconditionFailure("Custom public-key offers must use the asynchronous initializer")
         case .password(let passwordRequest):
             self.method = .password(passwordRequest.password)
         case .hostBased:
@@ -258,6 +270,28 @@ extension SSHMessage.UserAuthRequestMessage {
             self.method = .none
         }
     }
+
+    static func make(request: NIOSSHUserAuthenticationOffer, sessionID: ByteBuffer, on loop: EventLoop) -> EventLoopFuture<Self> {
+        switch request.offer {
+        case .customPublicKey(let publicKey, let sign):
+            let payload = UserAuthSignablePayload(
+                sessionIdentifier: sessionID,
+                userName: request.username,
+                serviceName: "ssh-connection",
+                publicKey: publicKey
+            )
+            let bytes = Data(payload.bytes.readableBytesView)
+            return sign(bytes, loop).flatMapThrowing { signatureBytes in
+                return Self(
+                    username: request.username,
+                    service: "ssh-connection",
+                    method: .publicKey(.known(key: publicKey, signature: try NIOSSHSignature(ed25519Signature: signatureBytes)))
+                )
+            }
+        default:
+            return loop.makeSucceededFuture(()).flatMapThrowing { try Self(request: request, sessionID: sessionID) }
+        }
+    }
 }
 
