diff --git a/Sources/NIOSSH/Keys And Signatures/NIOSSHSignature.swift b/Sources/NIOSSH/Keys And Signatures/NIOSSHSignature.swift
index be30e69..a3c8402 100644
--- a/Sources/NIOSSH/Keys And Signatures/NIOSSHSignature.swift	
+++ b/Sources/NIOSSH/Keys And Signatures/NIOSSHSignature.swift	
@@ -27,6 +27,18 @@ public struct NIOSSHSignature: Hashable, Sendable {
     internal init(backingSignature: BackingSignature) {
         self.backingSignature = backingSignature
     }
+
+    /// Creates an Ed25519 SSH signature from its 64-byte raw representation.
+    public init(ed25519Signature: Data) throws {
+        guard ed25519Signature.count == 64 else {
+            throw NIOSSHSignatureError.invalidEd25519SignatureLength(actual: ed25519Signature.count)
+        }
+        self.backingSignature = .ed25519(.data(ed25519Signature))
+    }
+}
+
+public enum NIOSSHSignatureError: Error, Equatable {
+    case invalidEd25519SignatureLength(actual: Int)
 }
 
