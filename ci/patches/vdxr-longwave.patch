+    // Longwave: copy the depth images released since the last frame from the application's own textures into
+    // the OVR images, on the application's queue, so the copies are ordered after its rendering and before the
+    // fence the submission context waits for. Called from xrEndFrame() with m_swapchainsMutex held.
+    void OpenXrRuntime::copyD3D12DepthImages() {
+        std::vector<Swapchain*> pending;
+        for (const auto& handle : m_swapchains) {
+            Swapchain& xrSwapchain = *(Swapchain*)handle;
+            if (xrSwapchain.d3d12DepthCopy && xrSwapchain.d3d12DepthPending && xrSwapchain.lastReleasedIndex >= 0 &&
+                xrSwapchain.lastReleasedIndex < (int)xrSwapchain.d3d12DepthAppImages.size()) {
+                pending.push_back(&xrSwapchain);
+            }
+        }
+        if (pending.empty()) {
+            return;
+        }
+
+        if (!m_d3d12DepthFence) {
+            CHECK_HRCMD(m_d3d12Device->CreateFence(
+                0, D3D12_FENCE_FLAG_NONE, IID_PPV_ARGS(m_d3d12DepthFence.ReleaseAndGetAddressOf())));
+        }
+        const uint32_t slot = m_d3d12DepthNextList++ % k_numD3D12DepthLists;
+        if (!m_d3d12DepthLists[slot]) {
+            CHECK_HRCMD(m_d3d12Device->CreateCommandAllocator(
+                D3D12_COMMAND_LIST_TYPE_DIRECT, IID_PPV_ARGS(m_d3d12DepthAllocators[slot].ReleaseAndGetAddressOf())));
+            CHECK_HRCMD(m_d3d12Device->CreateCommandList(0,
+                                                         D3D12_COMMAND_LIST_TYPE_DIRECT,
+                                                         m_d3d12DepthAllocators[slot].Get(),
+                                                         nullptr,
+                                                         IID_PPV_ARGS(m_d3d12DepthLists[slot].ReleaseAndGetAddressOf())));
+            CHECK_HRCMD(m_d3d12DepthLists[slot]->Close());
+        }
+        // The list last used k_numD3D12DepthLists frames ago; wait for it in the unlikely case it is still queued.
+        if (m_d3d12DepthFence->GetCompletedValue() < m_d3d12DepthListFenceValues[slot]) {
+            wil::unique_handle eventHandle;
+            *eventHandle.put() = CreateEventEx(nullptr, nullptr, 0, EVENT_ALL_ACCESS);
+            CHECK_HRCMD(m_d3d12DepthFence->SetEventOnCompletion(m_d3d12DepthListFenceValues[slot], eventHandle.get()));
+            WaitForSingleObject(eventHandle.get(), INFINITE);
+        }
+        CHECK_HRCMD(m_d3d12DepthAllocators[slot]->Reset());
+        ID3D12GraphicsCommandList* list = m_d3d12DepthLists[slot].Get();
+        CHECK_HRCMD(list->Reset(m_d3d12DepthAllocators[slot].Get(), nullptr));
+        for (Swapchain* xrSwapchain : pending) {
+            const int index = xrSwapchain->lastReleasedIndex;
+            D3D12_RESOURCE_BARRIER barrier{};
+            barrier.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+            barrier.Transition.pResource = xrSwapchain->d3d12DepthAppImages[index].Get();
+            barrier.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+            barrier.Transition.StateBefore = D3D12_RESOURCE_STATE_DEPTH_WRITE;
+            barrier.Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_SOURCE;
+            list->ResourceBarrier(1, &barrier);
+            list->CopyResource(xrSwapchain->d3d12Images[index].Get(), xrSwapchain->d3d12DepthAppImages[index].Get());
+            std::swap(barrier.Transition.StateBefore, barrier.Transition.StateAfter);
+            list->ResourceBarrier(1, &barrier);
+            xrSwapchain->d3d12DepthPending = false;
+        }
+        CHECK_HRCMD(list->Close());
+        m_d3d12CommandQueue->ExecuteCommandLists(1, reinterpret_cast<ID3D12CommandList**>(&list));
+        m_d3d12DepthListFenceValues[slot] = ++m_d3d12DepthFenceValue;
+        CHECK_HRCMD(m_d3d12CommandQueue->Signal(m_d3d12DepthFence.Get(), m_d3d12DepthFenceValue));
+    }
